[sub_resource type="GDScript" id="GDScript_sbqfj"]
resource_name = "ernesto"
script/source = "extends Area2D

@export var dialogue_path: String = \"res://dialogues/ernesto.dialogue\"

var player_in_area = false

func _ready():
	connect(\"body_entered\", Callable(self, \"_on_body_entered\"))
	connect(\"body_exited\", Callable(self, \"_on_body_exited\"))
	


func _on_body_entered(body):
	if body.name == \"player\":
		player_in_area = true

func _on_body_exited(body):
	if body.name == \"player\":
		player_in_area = false


func _process(delta):
	if player_in_area and Input.is_action_just_pressed(\"interact\"):
		Global.area_entered = true
		DialogueManager.show_dialogue_balloon(load(dialogue_path))
		
"

[sub_resource type="CircleShape2D" id="CircleShape2D_tn75u"]
radius = 49.010204

[sub_resource type="GDScript" id="GDScript_tyujp"]
resource_name = "beginning"
script/source = "extends Area2D

# This signal will be emitted when clicked
signal clicked

func _ready():
	# Enable mouse input
	input_pickable = true

func _input_event(viewport, event, shape_idx):
	# Check if the user clicked (left mouse button)
	if event is InputEventMouseButton and event.pressed and event.button_index == MOUSE_BUTTON_LEFT:
		emit_signal(\"clicked\")  # Optional: emit signal so other nodes can respond
		trigger_action()  # Call a custom function

func trigger_action():
	Global.came_from = true
	DialogueManager.show_dialogue_balloon(load(\"res://dialogues/where_you_came_from.dialogue\"))
"

