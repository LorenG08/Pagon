[sub_resource type="GDScript" id="GDScript_x3h0b"]
resource_name = "detection_area"
script/source = "extends Area2D

func _ready():
	connect(\"body_entered\", Callable(self, \"_on_body_entered\"))

func _on_body_entered(body):
	if body.name == \"player\":
		Global.area_entered = true
		DialogueManager.show_dialogue_balloon(load(\"res://dialogues/first.dialogue\"))
"

