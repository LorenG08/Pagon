[sub_resource type="TileSet" id="TileSet_o8aas"]
sources/0 = SubResource("TileSetAtlasSource_6njj8")
sources/1 = SubResource("TileSetAtlasSource_xee2f")
sources/2 = SubResource("TileSetAtlasSource_ixsdi")

[sub_resource type="GDScript" id="GDScript_o8aas"]
resource_name = "level1_4npc"
script/source = "extends Area2D

@export var dialogue_path: String = \"res://dialogues/level1-4npc.dialogue\"

var player_in_area = false

func _ready():
	connect(\"body_entered\", Callable(self, \"_on_body_entered\"))
	connect(\"body_exited\", Callable(self, \"_on_body_exited\"))
	


func _on_body_entered(body):
	if body.name == \"player\":
		player_in_area = true

func _on_body_exited(body):
	if body.name == \"player\":
		player_in_area = false


func _process(delta):
	if player_in_area and Input.is_action_just_pressed(\"interact\"):
		Global.area_entered = true
		DialogueManager.show_dialogue_balloon(load(dialogue_path))
		
"

