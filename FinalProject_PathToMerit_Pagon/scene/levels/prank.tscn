[sub_resource type="TileSet" id="TileSet_p0d14"]
sources/1 = SubResource("TileSetAtlasSource_6d3pc")
sources/2 = SubResource("TileSetAtlasSource_rhb87")

[sub_resource type="GDScript" id="GDScript_p0d14"]
resource_name = "prank"
script/source = "extends Area2D

@export var dialogue_path: String = \"res://dialogues/prank.dialogue\"

var player_in_area = false

func _ready():
	connect(\"body_entered\", Callable(self, \"_on_body_entered\"))
	connect(\"body_exited\", Callable(self, \"_on_body_exited\"))

func _on_body_entered(body):
	if body.name == \"player\":
		player_in_area = true

func _on_body_exited(body):
	if body.name == \"player\":
		player_in_area = false

func _process(delta):
	if player_in_area and Input.is_action_just_pressed(\"interact\"):
		Global.area_entered = true
		DialogueManager.show_dialogue_balloon(load(dialogue_path))
	if player_in_area and Input.is_action_just_pressed(\"space\"):
		Global.space = true
"

[sub_resource type="CircleShape2D" id="CircleShape2D_fxjnf"]
radius = 57.035076

[sub_resource type="GDScript" id="GDScript_fxjnf"]
resource_name = "merit"
script/source = "extends Label

@onready var merit_label: Label = %merit_label

func _process(delta):
	merit_label.text = \"Merit: \" + str(Global.merit)
"

[sub_resource type="GDScript" id="GDScript_u87cf"]
script/source = "extends Label

@onready var karma_label: Label = %karma_label

func _process(delta):
	karma_label.text = \"Karma: \" + str(Global.karma)
"

