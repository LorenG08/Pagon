[sub_resource type="GDScript" id="GDScript_j66qu"]
resource_name = "level2_nextlevel"
script/source = "extends Node


func _process(delta):
	if Global.next_level == true:
		get_tree().change_scene_to_file(\"res://scene/levels/level_3.tscn\")
		Global.next_level = false
	elif Global.donated == true:
		if Input.is_action_just_pressed(\"space\"):
			DialogueManager.show_dialogue_balloon(load(\"res://dialogues/next _level.dialogue\"))
	if Global.become_captain == true:
		get_tree().change_scene_to_file(\"res://scene/become_captain.tscn\")
"

